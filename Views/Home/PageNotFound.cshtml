@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center my-5">
    <h1 class="display-1 fw-bold" style="color:#4f46e5">404</h1>
    <h4>&#129773; This page took an unscheduled leave!</h4>
    <p class="text-muted">The page you are looking for does not exist or the URL was typed incorrectly.</p>
    <div class="mt-3">
        <a class="btn btn-gradient btn-lg" asp-controller="Home" asp-action="Index">&#127968; Back to Home</a>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Dashboard" asp-action="Index">&#128202; My Dashboard</a>
    </div>
    <p class="text-muted small mt-4">
        &#128161; Tip: "My Dashboard" lands every role on its own home page automatically.
    </p>
</div>
