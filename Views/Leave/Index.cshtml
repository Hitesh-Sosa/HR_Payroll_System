@model HrPayrollSystem.Models.LeavePageViewModel
@{ ViewData["Title"] = "My Leaves"; }

<h2 class="mb-4">My Leaves</h2>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<h5>My Balances (@DateTime.Now.Year)</h5>
<table class="table table-sm table-striped w-auto mb-4">
    <thead><tr><th>Leave Type</th><th>Remaining Days</th></tr></thead>
    <tbody>
    @foreach (var b in Model.Balances)
    {
        <tr><td>@b.LeaveType?.Name</td><td>@b.RemainingDays.ToString("0.##")</td></tr>
    }
    </tbody>
</table>

<h5>Apply for Leave</h5>
<div class="card mb-4"><div class="card-body">
<form asp-controller="Leave" asp-action="Apply" method="post" class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Leave Type</label>
        <select name="LeaveTypeId" class="form-select" required>
            <option value="">-- choose --</option>
            @foreach (var t in Model.LeaveTypes)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="StartDate" class="form-control" required />
    </div>
    <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="EndDate" class="form-control" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Reason</label>
        <input type="text" name="Reason" class="form-control" placeholder="optional" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Apply</button>
    </div>
</form>
</div></div>

<h5>My Requests</h5>
<table class="table table-striped table-bordered">
    <thead><tr><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Status</th><th>Applied On</th></tr></thead>
    <tbody>
    @if (!Model.MyRequests.Any())
    {
        <tr><td colspan="6" class="text-muted">No leave requests yet.</td></tr>
    }
    @foreach (var r in Model.MyRequests)
    {
        var badge = r.Status switch
        {
            LeaveStatus.Pending  => "warning text-dark",
            LeaveStatus.Approved => "success",
            LeaveStatus.Rejected => "danger",
            _ => "secondary"
        };
        <tr>
            <td>@r.LeaveType?.Name</td>
            <td>@r.StartDate.ToString("dd MMM yyyy")</td>
            <td>@r.EndDate.ToString("dd MMM yyyy")</td>
            <td>@r.NumberOfDays.ToString("0.##")</td>
            <td><span class="badge bg-@badge">@r.Status</span></td>
            <td>@r.AppliedOn.ToLocalTime().ToString("dd MMM HH:mm")</td>
        </tr>
    }
    </tbody>
</table>