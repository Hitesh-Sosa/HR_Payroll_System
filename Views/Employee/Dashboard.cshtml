@model HrPayrollSystem.Models.ViewModels.AttendanceDashboardViewModel
@{
    ViewData["Title"] = "My Attendance";
}

<h2 class="mb-4 fw-bold">My Attendance Dashboard</h2>

@if (Model.EmployeeId == 0)
{
    @* ===== ONE clear message (no duplicates!) ===== *@
    <div class="card border-0 shadow-sm p-4" style="border-left: 6px solid #f59e0b !important;">
        <h5>ðŸ‘‹ Welcome! Your account isn't linked to an employee profile yet.</h5>
        <p class="mb-2">An <strong>Admin</strong> connects logins to employee profiles in 30 seconds:</p>
        <ol class="mb-3">
            <li>Admin opens <strong>Admin Panel â†’ + Create Employee</strong></li>
            <li>Chooses <strong>"Link an EXISTING user account"</strong> â†’ selects your email</li>
            <li>Done â€” your dashboard, leave balances and payslips appear automatically âœ¨</li>
        </ol>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-gradient" asp-controller="Admin" asp-action="CreateEmployee">âž• Link an account now</a>
        }
        else
        {
            <span class="text-muted">Ask your Admin to link your account.</span>
        }
    </div>
}
else
{
    @* TempData alerts show ONLY when a profile exists (kills the duplicate!) *@
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible">@TempData["Error"]</div> }

    <div class="row">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-3 h-100" style="border-top: 5px solid #4f46e5 !important;">
                <div class="card-body">
                    <h5 class="fw-bold">@Model.EmployeeName</h5>
                    <p class="mb-1"><strong>Code:</strong> @Model.EmployeeCode</p>
                    <p class="mb-1"><strong>Department:</strong> @Model.DepartmentName</p>
                    <p class="mb-0"><strong>Server time:</strong> @Model.ServerTime.ToString("HH:mm")</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm mb-3 h-100" style="border-top: 5px solid #10b981 !important;">
                <div class="card-body">
                    <h5 class="fw-bold">Today â€” @DateTime.Now.ToString("ddd, dd MMM yyyy")</h5>

                    @if (Model.TodayAttendance == null)
                    {
                        <p class="text-muted">You have not checked in today.</p>
                        <form asp-controller="Employee" asp-action="CheckIn" method="post">
                            <button type="submit" class="btn btn-gradient btn-lg">âœ… Check In</button>
                        </form>
                    }
                    else if (Model.TodayAttendance.CheckOut == null)
                    {
                        <p>
                            Checked in at <strong>@Model.TodayAttendance.CheckIn?.ToString("HH:mm")</strong>
                            <span class="badge bg-warning text-dark ms-2">@Model.TodayAttendance.Status</span>
                        </p>
                        <form asp-controller="Employee" asp-action="CheckOut" method="post">
                            <button type="submit" class="btn btn-danger btn-lg">ðŸ Check Out</button>
                        </form>
                    }
                    else
                    {
                        <p class="mb-1">
                            In: <strong>@Model.TodayAttendance.CheckIn?.ToString("HH:mm")</strong> |
                            Out: <strong>@Model.TodayAttendance.CheckOut?.ToString("HH:mm")</strong> |
                            Hours: <strong>@Model.TodayAttendance.HoursWorked.ToString("0.00")</strong>
                            <span class="badge bg-primary ms-2">@Model.TodayAttendance.Status</span>
                        </p>
                        <p class="text-success mb-0 fw-semibold">âœ… Your day is complete. See you tomorrow!</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <h5 class="mt-4 fw-bold">This Month (@DateTime.Now.ToString("MMMM yyyy"))</h5>
    <div class="card border-0 shadow-sm">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-header-brand">
                <tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Hours</th><th>Status</th></tr>
            </thead>
            <tbody>
                @if (!Model.MonthlyAttendance.Any())
                {
                    <tr><td colspan="5" class="text-muted p-3">No attendance records yet this month.</td></tr>
                }
                @foreach (var a in Model.MonthlyAttendance)
                {
                    var badgeClass = a.Status switch
                    {
                        AttendanceStatus.Present => "success",
                        AttendanceStatus.Late    => "warning text-dark",
                        AttendanceStatus.HalfDay => "info text-dark",
                        AttendanceStatus.OnLeave => "secondary",
                        AttendanceStatus.Absent  => "danger",
                        _ => "dark"
                    };
                    <tr>
                        <td>@a.Date.ToString("dd MMM (ddd)")</td>
                        <td>@a.CheckIn?.ToString("HH:mm")</td>
                        <td>@(a.CheckOut != null ? a.CheckOut?.ToString("HH:mm") : "â€”")</td>
                        <td>@(a.CheckOut != null ? a.HoursWorked.ToString("0.00") : "â€”")</td>
                        <td><span class="badge bg-@badgeClass">@a.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
