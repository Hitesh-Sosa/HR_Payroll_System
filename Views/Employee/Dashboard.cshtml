@model HrPayrollSystem.Models.ViewModels.AttendanceDashboardViewModel
@{
    ViewData["Title"] = "My Attendance";
}

<h2 class="mb-4">My Attendance Dashboard</h2>

@* ===== One-shot messages (survive exactly one redirect) ===== *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">@TempData["Error"]</div>
}

@* ===== No employee profile linked yet ===== *@
@if (Model.EmployeeId == 0)
{
    <div class="alert alert-warning">
        <strong>No employee profile is linked to your account.</strong><br />
        The Admin creates employee profiles (coming in Session 8).
        For now, test the dashboard with <code>admin@hr.com</code> (profile EMP001).
    </div>
}
else
{
    <div class="row">
        @* ===== Profile card ===== *@
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@Model.EmployeeName</h5>
                    <p class="card-text mb-1"><strong>Code:</strong> @Model.EmployeeCode</p>
                    <p class="card-text mb-1"><strong>Department:</strong> @Model.DepartmentName</p>
                    <p class="card-text mb-0"><strong>Server time:</strong> @Model.ServerTime.ToString("HH:mm")</p>
                </div>
            </div>
        </div>

        @* ===== Today card ===== *@
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Today — @DateTime.Now.ToString("ddd, dd MMM yyyy")</h5>

                    @if (Model.TodayAttendance == null)
                    {
                        <p class="text-muted">You have not checked in today.</p>

                        <form asp-controller="Employee" asp-action="CheckIn" method="post">
                            <button type="submit" class="btn btn-success btn-lg">✅ Check In</button>
                        </form>
                    }
                    else if (Model.TodayAttendance.CheckOut == null)
                    {
                        <p>
                            Checked in at
                            <strong>@Model.TodayAttendance.CheckIn?.ToString("HH:mm")</strong>
                            —
                            <span class="badge bg-warning text-dark">@Model.TodayAttendance.Status</span>
                        </p>

                        <form asp-controller="Employee" asp-action="CheckOut" method="post">
                            <button type="submit" class="btn btn-danger btn-lg">🏁 Check Out</button>
                        </form>
                    }
                    else
                    {
                        <p class="mb-1">
                            In: <strong>@Model.TodayAttendance.CheckIn?.ToString("HH:mm")</strong>
                            &nbsp;|&nbsp; Out: <strong>@Model.TodayAttendance.CheckOut?.ToString("HH:mm")</strong>
                        </p>
                        <p class="mb-1">
                            Hours: <strong>@Model.TodayAttendance.HoursWorked.ToString("0.00")</strong>
                            &nbsp;|&nbsp;
                            <span class="badge bg-primary">@Model.TodayAttendance.Status</span>
                        </p>
                        <p class="text-muted mb-0">✅ Your day is complete. See you tomorrow!</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ===== This month's attendance ===== *@
    <h4 class="mt-4">This Month's Attendance (@DateTime.Now.ToString("MMMM yyyy"))</h4>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Check In</th>
                <th>Check Out</th>
                <th>Hours</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.MonthlyAttendance.Any())
            {
                <tr><td colspan="5" class="text-muted">No attendance records yet this month.</td></tr>
            }
            @foreach (var a in Model.MonthlyAttendance)
            {
                var badgeClass = a.Status switch
                {
                    AttendanceStatus.Present => "success",
                    AttendanceStatus.Late    => "warning text-dark",
                    AttendanceStatus.HalfDay => "info text-dark",
                    AttendanceStatus.OnLeave => "secondary",
                    AttendanceStatus.Absent  => "danger",
                    _ => "dark"
                };
                <tr>
                    <td>@a.Date.ToString("dd MMM (ddd)")</td>
                    <td>@a.CheckIn?.ToString("HH:mm")</td>
                    <td>@(a.CheckOut != null ? a.CheckOut?.ToString("HH:mm") : "—")</td>
                    <td>@(a.CheckOut != null ? a.HoursWorked.ToString("0.00") : "—")</td>
                    <td><span class="badge bg-@badgeClass">@a.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}