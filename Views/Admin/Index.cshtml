@model List<HrPayrollSystem.Models.Employee>
@{ ViewData["Title"] = "Admin Dashboard"; }

<h2 class="mb-3">Admin Dashboard</h2>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card mb-4">
    <div class="card-body">
        <h5>Departments</h5>
        <ul class="list-inline">
            @foreach (var d in (List<HrPayrollSystem.Models.Department>)ViewBag.Departments)
            {
                <li class="list-inline-item me-3">
                    <span class="badge bg-secondary">@d.Name</span>
                    <form asp-controller="Admin" asp-action="DeleteDepartment" method="post" class="d-inline"
                          onsubmit="return confirm('Delete @d.Name?');">
                        <input type="hidden" name="id" value="@d.Id" />
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">✕</button>
                    </form>
                </li>
            }
        </ul>
        <form asp-controller="Admin" asp-action="AddDepartment" method="post" class="row g-2 mt-1">
            <div class="col-auto">
                <input type="text" name="name" class="form-control" placeholder="New department name" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Add Department</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Employees</h5>
    <a class="btn btn-success" asp-controller="Admin" asp-action="CreateEmployee">+ Create Employee</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Code</th><th>Name</th><th>Designation</th><th>Department</th>
            <th>Gross Salary</th><th>Status</th><th>Salary Structure</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var emp in Model)
    {
        <tr class="@(emp.IsActive ? "" : "table-secondary")">
            <td>@emp.EmployeeCode</td>
            <td>@emp.FullName</td>
            <td>@emp.Designation</td>
            <td>@emp.Department?.Name</td>
            <td>@emp.GrossMonthlySalary.ToString("N0")</td>
            <td>
                @if (emp.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary"
                   asp-controller="Admin" asp-action="Salary"
                   asp-route-employeeId="@emp.Id">💰 Salary</a>
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary"
                   asp-controller="Admin" asp-action="EditEmployee"
                   asp-route-id="@emp.Id">Edit</a>

                @if (emp.IsActive)
                {
                    <form asp-controller="Admin" asp-action="Deactivate" method="post" class="d-inline"
                          onsubmit="return confirm('Deactivate @emp.FullName?');">
                        <input type="hidden" name="id" value="@emp.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>