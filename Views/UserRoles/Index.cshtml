@model List<HrPayrollSystem.Controllers.UserRolesController.UserRoleVm>
@{ ViewData["Title"] = "Manage Roles"; }

<h2 class="mb-4">👥 Manage User Roles</h2>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card shadow-sm border-0">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-header-brand">
            <tr><th>User</th><th>Current Role(s)</th><th style="width:280px">Change Role</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="fw-semibold">@u.Email</td>
                <td>
                    @foreach (var r in u.Roles)
                    {
                        <span class="badge role-badge role-@r.ToLower()">@r</span>
                    }
                    @if (!u.Roles.Any()) { <span class="badge bg-secondary">No role</span> }
                </td>
                <td>
                    <form asp-controller="UserRoles" asp-action="ChangeRole" method="post" class="d-flex gap-2">
                        <input type="hidden" name="userId" value="@u.UserId" />
                        <select name="newRole" class="form-select form-select-sm">
                            @foreach (var r in (List<string>)ViewBag.AllRoles)
                            {
                                <option value="@r" selected="@(u.Roles.Contains(r) && u.Roles.Count == 1)">@r</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>