<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HrPayrollSystem</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background: #f4f5fb;
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1 0 auto;
            width: 100%;
        }

        .bg-gradient-brand {
            background: linear-gradient(135deg, #4f46e5, #7c3aed 55%, #a855f7) !important;
        }

        .navbar {
            box-shadow: 0 2px 14px rgba(79, 70, 229, .3);
        }

        .navbar .nav-link {
            color: #e0e7ff !important;
            font-weight: 500;
            border-radius: 8px;
            margin: 2px;
        }

        .navbar .nav-link:hover {
            background: rgba(255, 255, 255, .15);
            color: #fff !important;
        }

        .navbar-brand {
            color: #fff !important;
            font-weight: 800;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #fff;
            border: none;
        }

        .btn-gradient:hover {
            color: #fff;
            filter: brightness(1.1);
        }

        .role-badge {
            font-size: .72rem;
            padding: .35em .7em;
            border-radius: 20px;
        }

        .role-admin {
            background: #fee2e2;
            color: #b91c1c;
        }

        .role-manager {
            background: #ffedd5;
            color: #c2410c;
        }

        .role-hr {
            background: #fef9c3;
            color: #a16207;
        }

        .role-employee {
            background: #dcfce7;
            color: #15803d;
        }

        .hero {
            background: linear-gradient(135deg, #4f46e5, #7c3aed 60%, #a855f7);
            color: #fff;
            border-radius: 20px;
            padding: 2.6rem 1.8rem;
        }

        .hero h1 {
            font-weight: 800;
        }

        .feature-card {
            background: #fff;
            border-radius: 16px;
            height: 100%;
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 26px rgba(30, 41, 59, .15);
        }

        .feature-card .icon {
            width: 54px;
            height: 54px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            border-radius: 14px;
            margin-bottom: .8rem;
        }

        .footer-dark {
            background: #1e1b4b;
            color: #c7d2fe;
            margin-top: auto;
            padding: 2rem 0;
        }

        .footer-dark a {
            color: #a5b4fc;
            text-decoration: none;
        }

        .footer-dark a:hover {
            color: #fff;
            text-decoration: underline;
        }

        .table-header-brand th {
            background: linear-gradient(135deg, #eef2ff, #f3e8ff);
            color: #3730a3;
        }

        .stat-card {
            border-radius: 14px;
            text-align: center;
        }

        @@media (max-width: 768px) {
            .hero {
                padding: 1.6rem 1rem;
            }
        }
    </style>
</head>

<body>

    <!-- ========================= NAVBAR ========================= -->

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-gradient-brand sticky-top">
            <div class="container-fluid px-4">

                <!-- Application Name -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    &#127970; HrPayrollSystem
                </a>

                <!-- Mobile Navbar Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div id="mainNavbar" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <!-- MY DASHBOARD (smart door: lands each role on its own dashboard) -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    &#127968; My Dashboard
                                </a>
                            </li>
                        }

                        <!-- MY ATTENDANCE -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employee" asp-action="Dashboard">
                                    &#128197; My Attendance
                                </a>
                            </li>
                        }

                        <!-- MY LEAVES -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Leave" asp-action="Index">
                                    &#128221; My Leaves
                                </a>
                            </li>
                        }

                        <!-- APPROVE LEAVES -->
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("HR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Leave" asp-action="Pending">
                                    &#9989; Approve Leaves
                                </a>
                            </li>
                        }

                        <!-- MY PAYSLIPS -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Payroll" asp-action="MyPayslips">
                                    &#128176; My Payslips
                                </a>
                            </li>
                        }

                        <!-- ADMIN-ONLY PAYROLL -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Payroll" asp-action="Index">
                                    &#128181; Payroll
                                </a>
                            </li>
                        }

                        <!-- ADMIN PANEL -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    &#9881;&#65039; Admin Panel
                                </a>
                            </li>
                        }

                        <!-- MANAGE ROLES -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="UserRoles" asp-action="Index">
                                    &#128101; Manage Roles
                                </a>
                            </li>
                        }

                        <!-- PRIVACY -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                &#128274; Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- LOGIN / LOGOUT -->
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>


    <!-- ========================= MAIN CONTENT ========================= -->

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <!-- ========================= FOOTER ========================= -->

    <footer class="footer-dark">
        <div class="container">
            <div class="row g-3">

                <!-- APPLICATION -->
                <div class="col-md-4">
                    <h6 class="text-white">&#127970; HrPayrollSystem</h6>
                    <small>Attendance &bull; Leaves &bull; Payroll &bull; Payslips</small>
                </div>

                <!-- QUICK LINKS -->
                <div class="col-md-4">
                    <h6 class="text-white">Quick Links</h6>
                    <small>
                        <a asp-controller="Dashboard" asp-action="Index">My Dashboard</a>
                        &bull;
                        <a asp-controller="Leave" asp-action="Index">My Leaves</a>
                        &bull;
                        <a asp-controller="Payroll" asp-action="MyPayslips">My Payslips</a>
                    </small>
                </div>

                <!-- COPYRIGHT -->
                <div class="col-md-4 text-md-end">
                    <small>&copy; @DateTime.Now.Year - Built with ASP.NET Core MVC</small>
                </div>

            </div>
        </div>
    </footer>


    <!-- ========================= JAVASCRIPT ========================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>