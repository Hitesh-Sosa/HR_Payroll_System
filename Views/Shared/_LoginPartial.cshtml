@using Microsoft.AspNetCore.Identity
@using HrPayrollSystem.Data
@inject SignInManager<ApplicationUser> SignInManager

@{
    var role = User.IsInRole("Admin") ? "Admin"
             : User.IsInRole("Manager") ? "Manager"
             : User.IsInRole("HR") ? "HR"
             : User.IsInRole("Employee") ? "Employee"
             : null;
}

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-2">
        @if (role != null)
        {
            <span class="badge role-badge role-@role.ToLower()">@role</span>
        }
        <a class="nav-link d-inline text-white" asp-area="Identity" asp-page="/Account/Manage/Index">
            @User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" class="d-inline">
            <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
    <li class="nav-item"><a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
}
</ul>